    {"id": "allday2", "groups": ["event"], "tier": "complex", "nuance": "all_day", "shape": "{F} all day {g_date}", "flags": {"all_day": true}},

    {"id": "none",    "groups": ["todo", "shop", "del_ev", "del_td", "done", "query"], "tier": "simple", "shape": "{F}"},
