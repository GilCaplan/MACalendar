  "_comment_group_weights": "Each level's rows are shared out by GROUP before family, so the action mix tracks the base set's (create_event 38%, create_todo 19%, compounds 31%) instead of whichever group has the most frames. A group that cannot supply its share hands the rest to the whole pool.",
  "group_weights": {"event": 0.30, "todo": 0.16, "shop": 0.06, "compound": 0.24, "del_ev": 0.05, "del_td": 0.025, "done": 0.035, "upd_ev": 0.055, "upd_dur": 0.01, "upd_td": 0.025, "query": 0.04},

  "groups": {
    "event":   {"action": "create_event",  "T": "{g_event}", "kind": "event"},
    "todo":    {"action": "create_todo",   "T": "{g_task}",  "kind": "task"},
    "shop":    {"action": "create_todo",   "T": "{g_item}",  "kind": "task"},
    "del_ev":  {"action": "delete_event",  "T": "{g_event}"},
    "del_td":  {"action": "delete_todo",   "T": "{g_task}"},
    "done":    {"action": "complete_todo", "T": "{g_task}"},
    "upd_ev":  {"action": "update_event",  "T": "{g_event}"},
    "upd_dur": {"action": "update_event",  "T": "{g_event}"},
    "upd_td":  {"action": "update_todo",   "T": "{g_task}"},
    "query":   {"action": "query",         "T": ""}
  },

