  "_comment_arrangements": "{F} is the construction's frame with {T} filled in; T overrides what {T} becomes (a title with a place or a person attached). fronted: the when comes first, so prefix wrappers that need an instruction to follow are not offered. nodet: skipped for constructions marked det. qty: only for constructions marked qty. tier/nuance follow the base set: single-shape arrangements are simple, the rest complex.",

  "arrangements": [
    {"id": "dclk",    "groups": ["event"], "tier": "simple", "shape": "{F} {g_date} at {g_clock}"},
    {"id": "clkd",    "groups": ["event"], "tier": "simple", "shape": "{F} at {g_clock} {g_date}"},
    {"id": "wkclk",   "groups": ["event"], "tier": "simple", "shape": "{F} on {weekday} at {g_clock}"},
    {"id": "front",   "groups": ["event"], "tier": "simple", "shape": "{g_date} at {g_clock}, {F}", "fronted": true},
    {"id": "drng",    "groups": ["event"], "tier": "simple", "shape": "{F} {g_date} {g_range}"},
    {"id": "fordclk", "groups": ["event"], "tier": "simple", "shape": "{F} for {g_pdate} at {g_clock}"},
    {"id": "date",    "groups": ["event"], "tier": "simple", "shape": "{F} {g_date}"},
    {"id": "clk",     "groups": ["event"], "tier": "simple", "shape": "{F} at {g_clock}"},
    {"id": "wk",      "groups": ["event"], "tier": "simple", "shape": "{F} on {weekday}"},
    {"id": "len",     "groups": ["event"], "tier": "complex", "nuance": "duration", "shape": "{F} {g_date} at {g_clock} for {g_length}"},
    {"id": "recclk",  "groups": ["event"], "tier": "complex", "nuance": "recurrence", "shape": "{F} {g_recur} at {g_clock}"},
    {"id": "recstart","groups": ["event"], "tier": "complex", "nuance": "recurrence", "shape": "{F} {g_recur} starting {g_date}"},
    {"id": "recuntil","groups": ["event"], "tier": "complex", "nuance": "until_through", "shape": "{F} {g_recur} at {g_clock} until {g_pdate2}", "fixed_slots": {"end_inclusive": false}},
    {"id": "recthru", "groups": ["event"], "tier": "complex", "nuance": "until_through", "shape": "{F} {g_recur} through {g_pdate2}", "fixed_slots": {"end_inclusive": true}},
    {"id": "with",    "groups": ["event"], "tier": "complex", "nuance": "attendee", "shape": "{F} {g_date} at {g_clock}", "T": "{g_event} with {g_name}"},
    {"id": "place",   "groups": ["event"], "tier": "complex", "nuance": "location", "shape": "{F} {g_date} at {g_clock}", "T": "{g_event} at {g_place}", "fixed_slots": {"title": "{g_event} at {g_place}"}},
