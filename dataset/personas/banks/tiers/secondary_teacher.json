    "action_bias": "balanced: a dense fixed timetable plus a long marking-and-admin list",
    "leak_note": "Every school, colleague and pupil name is invented for the size tiers; none was taken from any real person or transcript — and the leak gate runs on every tier build (see PERSONAS.md § Size tiers for what it currently reads)."
  },
  "fillers": {
    "names": ["Ottilie", "Kwame", "Siobhan", "Rafferty", "Greta", "Idris", "Maeve", "Joaquin", "Leopold", "Saskia", "Thaddeus", "Ursula", "Valentin", "Winifred", "Xander", "Yvaine"],
