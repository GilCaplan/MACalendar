    "joiner_then_et": ["add {event_title} at {time}, then remind me to {task_title2}"],
    "also_ee": ["add {event_title} {date}, and also {event_title2} {date2}"],
    "mixed_create_delete": ["please cancel {event_title2} and add {event_title} {date}"],
    "three_ask": ["add {event_title} at {time} and {event_title2} at {time2} and remind me to {task_title3}"]
