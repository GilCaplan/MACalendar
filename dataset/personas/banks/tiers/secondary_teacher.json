  "mix": {"ct_bare": 1.4, "ct_dated": 1.5, "ce_datetime": 1.4, "ce_date_only": 1.3, "ce_allday": 1.2, "q_schedule": 1.2, "q_todos": 1.2, "and_tt": 1.2, "three_ask": 0.9, "propose_q": 0.6},
  "templates": {
